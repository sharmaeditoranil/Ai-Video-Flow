<?xml version="1.0" encoding="UTF-8"?>
<!-- AI Video Flow bridge for Adobe Premiere Pro (CC 2022 and newer: 2024, 2025, 2026 ...).
     A hidden service starts with Premiere; the panel (Window > Extensions > AI Video Flow) is a manual fallback. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.aivideoflow.bridge" ExtensionBundleVersion="1.0.0" ExtensionBundleName="AI Video Flow">
  <ExtensionList>
    <Extension Id="com.aivideoflow.bridge.service" Version="1.0.0"/>
    <Extension Id="com.aivideoflow.bridge.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.aivideoflow.bridge.service">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
            <Event>com.adobe.csxs.events.ApplicationInitialized</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry><Size><Height>1</Height><Width>1</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.aivideoflow.bridge.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AI Video Flow</Menu>
          <Geometry><Size><Height>160</Height><Width>320</Width></Size></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
